{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": [
    "en",
    "pt-BR"
  ],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-m-function-matcher@2/dist/index.js"
  ],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}/app.json",
      "./messages/{locale}/account.json",
      "./messages/{locale}/library.json",
      "./messages/{locale}/entry.json",
      "./messages/{locale}/server.json",
      "./messages/{locale}/instance.json",
      "./messages/{locale}/content.json",
      "./messages/{locale}/screenshot.json",
      "./messages/{locale}/skin.json",
      "./messages/{locale}/settings.json",
      "./messages/{locale}/plugins.json",
      "./messages/{locale}/onboarding.json",
      "./messages/{locale}/domain.json",
      "./messages/{locale}/error.json",
      "./messages/{locale}/warning.json"
    ]
  }
}
