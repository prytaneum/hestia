{
  "type": "stack",
  "direction": "vertical",
  "children": [
    { "type": "heading", "text": "Backups", "level": 1 },
    { "type": "text", "text": "Last run 2h ago", "tone": "muted" },
    { "type": "markdown", "source": "**Hello** [docs](https://example.com)" },
    { "type": "image", "src": "assets/logo.png", "alt": "Logo" },
    {
      "type": "table",
      "columns": ["Name", "Size"],
      "rows": [
        { "cells": ["world", "12 MB"], "payload": { "id": "w1" } }
      ],
      "filter": true,
      "rowAction": "open",
      "empty": "No files"
    },
    {
      "type": "section",
      "title": "Tunnels",
      "description": "Up while the server runs",
      "actions": [
        {
          "type": "button",
          "label": "Add",
          "action": { "id": "add", "payload": null },
          "variant": "secondary"
        }
      ],
      "children": [{ "type": "copy", "text": "abc.example.com:1234", "label": "Address" }]
    },
    { "type": "copy", "text": "abc.example.com:1234" },
    { "type": "remote_image", "url": "https://example.com/a.png", "alt": "A", "shape": "avatar" },
    { "type": "badge", "text": "Online", "tone": "success" },
    {
      "type": "tabs",
      "tabs": [
        {
          "id": "one",
          "label": "One",
          "children": [
            {
              "type": "button",
              "label": "Delete",
              "action": { "id": "delete", "payload": null },
              "variant": "danger",
              "confirm": "Delete it?"
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "items": [
        {
          "title": "Nightly",
          "subtitle": "03:00",
          "icon": "clock",
          "image": { "url": "https://example.com/a.png", "shape": "avatar" },
          "badges": [{ "text": "Online", "tone": "success" }],
          "actions": [
            {
              "type": "button",
              "label": "Run",
              "action": { "id": "run", "payload": null },
              "variant": "secondary"
            }
          ]
        }
      ],
      "empty": "No schedules"
    },
    {
      "type": "detail",
      "pairs": [{ "label": "Retention", "value": "7 days" }]
    },
    {
      "type": "form",
      "id": "settings",
      "fields": [
        {
          "type": "text",
          "name": "title",
          "label": "Title",
          "help": "Shown in the list",
          "value": "a",
          "placeholder": "Name"
        },
        {
          "type": "number",
          "name": "keep",
          "label": "Keep",
          "value": 7.0,
          "min": 1.0,
          "max": 30.0,
          "step": 1.0
        },
        { "type": "toggle", "name": "on", "label": "Enabled", "value": true },
        {
          "type": "select",
          "name": "mode",
          "label": "Mode",
          "options": [{ "value": "fast", "label": "Fast" }],
          "value": "fast"
        },
        { "type": "entry", "name": "target", "label": "Server", "kind": "server" }
      ],
      "submit": {
        "label": "Save",
        "action": { "id": "save", "payload": { "x": 1 } }
      }
    },
    { "type": "notice", "tone": "warning", "text": "Careful" },
    { "type": "progress", "fraction": 0.5, "label": "Halfway" },
    { "type": "webview", "src": "assets/chart.html", "height": 320 }
  ]
}
