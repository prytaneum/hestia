{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hestia",
  "version": "1.0.0-beta.3",
  "identifier": "org.prytaneum.hestia",
  "build": {
    "beforeDevCommand": "cd ../frontend && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../frontend && bun run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hestia",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Hestia",
        "url": "splashscreen.html",
        "width": 360,
        "height": 300,
        "minWidth": 360,
        "minHeight": 300,
        "maxWidth": 360,
        "maxHeight": 300,
        "decorations": false,
        "resizable": true,
        "center": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost hestia-image: http://hestia-image.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data:",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; font-src 'self' http://localhost:1420 data:; img-src 'self' http://localhost:1420 asset: http://asset.localhost hestia-image: http://hestia-image.localhost data: blob:; connect-src 'self' http://localhost:1420 ws://localhost:1420 ipc: http://ipc.localhost asset: http://asset.localhost data:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hestia"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Fast, lightweight Minecraft launcher",
    "longDescription": "Hestia is a cross-platform Minecraft launcher. The desktop app is a thin client that drives the bundled hestiad daemon over a local socket.",
    "publisher": "prytaneum",
    "homepage": "https://github.com/prytaneum/hestia",
    "copyright": "Copyright © 2026 toraaoo. Published by prytaneum.",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "fileAssociations": [
      {
        "ext": ["hestia"],
        "name": "Hestia instance archive",
        "description": "Hestia instance archive",
        "mimeType": "application/vnd.hestia.instance+zip",
        "role": "Editor"
      }
    ],
    "resources": {
      "bundled-plugins/": "plugins/"
    },
    "externalBin": [
      "binaries/hestiad",
      "binaries/hestia-tray",
      "binaries/hestia"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "both",
        "startMenuFolder": "Hestia"
      }
    }
  }
}
