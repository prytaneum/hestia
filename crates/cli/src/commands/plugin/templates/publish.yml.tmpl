name: publish

on:
  push:
    branches: [main]
  schedule:
    - cron: "17 4 * * 1"

jobs:
  publish:
    permissions:
      contents: write
    uses: prytaneum/hestia/.github/workflows/plugin-publish.yml@{workflow_ref}
    with:
      hestia-ref: {hestia_rev}
    secrets:
      HESTIA_SIGNING_KEY: ${{ secrets.HESTIA_SIGNING_KEY }}
