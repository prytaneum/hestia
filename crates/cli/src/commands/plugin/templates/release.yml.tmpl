name: release

on:
  push:
    tags: ["*-v*"]

jobs:
  release:
    permissions:
      contents: write
    uses: prytaneum/hestia/.github/workflows/plugin-release.yml@feature/plugins
    with:
      hestia-ref: refs/heads/feature/plugins
    secrets:
      HESTIA_SIGNING_KEY: ${{ secrets.HESTIA_SIGNING_KEY }}
