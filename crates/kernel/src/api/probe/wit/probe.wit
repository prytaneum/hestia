package hestia:probe@0.1.0;

/// A typed call: one router channel, converted both ways.
interface read {
    use hestia:kernel/types@0.1.0.{plugin-error};

    record echoed {
        text: string,
        length: u32,
    }

    echo: func(text: string) -> result<echoed, plugin-error>;
}

/// A job function: it returns when the job it starts is done.
interface work {
    use hestia:kernel/types@0.1.0.{plugin-error};
    use read.{echoed};

    shout: func(text: string) -> result<echoed, plugin-error>;
}

/// Calls that act on entries: `open` touches one, `create` makes one, `build`
/// makes one through a job.
interface entries {
    use hestia:kernel/types@0.1.0.{plugin-error};

    open: func(id: string) -> result<string, plugin-error>;
    create: func(id: string) -> result<string, plugin-error>;
    build: func(id: string) -> result<string, plugin-error>;
}

/// An extension point: the plugin that exports it fills it.
interface filler {
    use hestia:kernel/types@0.1.0.{plugin-error};

    fill: func(text: string) -> result<string, plugin-error>;
}

/// Stand-ins for the version gates: no world imports them, so the gate's tests
/// read them from the table and the WIT, and no guest links against them.
@unstable(feature = preview)
interface preview {
    peek: func() -> string;
}

@since(version = 0.1.0)
@deprecated(version = 0.1.0)
interface legacy {
    peek: func() -> string;
}

world host {
    import read;
    import work;
    import entries;
    export filler;
}
