package hestia:probe@0.1.0;

/// A typed call: one router channel, converted both ways.
interface read {
    use hestia:kernel/types@0.1.0.{plugin-error};

    record echoed {
        text: string,
        length: u32,
    }

    echo: func(text: string) -> result<echoed, plugin-error>;
}

/// A job function: it returns when the job it starts is done.
interface work {
    use hestia:kernel/types@0.1.0.{plugin-error};
    use read.{echoed};

    shout: func(text: string) -> result<echoed, plugin-error>;
}

/// Calls that act on entries: `open` touches one, `create` makes one, `build`
/// makes one through a job.
interface entries {
    use hestia:kernel/types@0.1.0.{plugin-error};

    open: func(id: string) -> result<string, plugin-error>;
    create: func(id: string) -> result<string, plugin-error>;
    build: func(id: string) -> result<string, plugin-error>;
}

/// An extension point: the plugin that exports it fills it.
interface filler {
    use hestia:kernel/types@0.1.0.{plugin-error};

    fill: func(text: string) -> result<string, plugin-error>;
}

/// A topic: the plugin that exports it hears each event, in its own inbox.
interface entry-opened {
    use hestia:kernel/types@0.1.0.{plugin-error};

    heard: func(entry: string) -> result<_, plugin-error>;
}

/// A hook: customisation, run in plugin id order, each seeing what the one
/// before returned. Only `veto` stops the others.
interface before-echo {
    use hestia:kernel/types@0.1.0.{plugin-error};

    variant verdict {
        proceed(string),
        veto(string),
    }

    check: func(text: string) -> result<verdict, plugin-error>;
}

/// Stand-ins for the version gates: no world imports them, so the gate's tests
/// read them from the table and the WIT, and no guest links against them.
@unstable(feature = preview)
interface preview {
    peek: func() -> string;
}

@since(version = 0.1.0)
@deprecated(version = 0.1.0)
interface legacy {
    peek: func() -> string;
}

world host {
    import read;
    import work;
    import entries;
    export filler;
}

/// The extension points of a plugin that listens, apart from `host` so a guest
/// that only uses the package need not implement them.
world listener {
    export entry-opened;
    export before-echo;
}

/// What the sandbox knows of the package.
world full {
    include host;
    include listener;
}
