package hestia:plugin@1.0.0;

/// Every hook point, through one call. The points, what each shows the plugin
/// and what it may answer are `proto::hook`: a point is data, so adding one
/// never changes this interface.
interface hooks {
    use types.{json};

    /// Runs the hook point `point`, which the manifest declares under
    /// `contributes.hooks`. `context` is the point's `Context` as JSON. Answer
    /// the point's `Patch` as JSON (`null` for nothing to add), or an error to
    /// veto the operation, whose text is shown to the user as the reason. A call
    /// that traps or overruns its two seconds is skipped instead: hooks fail open.
    intercept: func(point: string, context: json) -> result<json, string>;
}
