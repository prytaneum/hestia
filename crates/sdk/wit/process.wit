package hestia:plugin@1.0.0;

/// Runs the programs the manifest declares, and only those. Every function
/// answers `permission-denied` unless the plugin holds `process:spawn`, and a
/// program or argument list the manifest did not declare is refused the same
/// way. There is no shell: arguments are passed as given, the working
/// directory is the plugin's `data/` unless `exec` names another, and the
/// environment starts empty plus the variables the program declares.
interface process {
    use types.{plugin-error};

    record exec-output {
        /// `none` when the program was ended by a signal.
        status: option<s32>,
        /// Each stream is cut at 1 MiB.
        stdout: list<u8>,
        stderr: list<u8>,
    }

    enum state {
        running,
        exited,
        killed,
    }

    record process-status {
        state: state,
        exit-code: option<s32>,
    }

    /// Runs a program to completion. One that outlasts `timeout-ms`, or the
    /// time the current call has left, is killed with everything it started, as
    /// is one still running when the call is cancelled or dropped. `env` may
    /// only name variables the program declares; its `PATH` is built from the
    /// programs it lists in `path`. An argument may hold `${build}`, `${vanilla}`
    /// or `${data}`, which the host replaces with the host path of that mount
    /// of this call (`permission-denied` when the call has no such mount).
    /// `cwd` is a guest path under a writable mount of this call (`/data`, or
    /// `/build` during a flavor's `build`); `none` runs in `data/`. Any other
    /// directory is `permission-denied`.
    exec: func(program: string, args: list<string>, env: list<tuple<string, string>>, timeout-ms: u32, cwd: option<string>) -> result<exec-output, plugin-error>;

    /// Starts a long-lived program under the daemon's supervisor and returns its
    /// process id. The id is persistent: it names the process after the daemon
    /// restarts, and `list` finds it again.
    spawn: func(program: string, args: list<string>, env: list<tuple<string, string>>) -> result<string, plugin-error>;

    /// Asks one of the plugin's own processes to stop.
    stop: func(id: string) -> result<_, plugin-error>;

    status: func(id: string) -> result<process-status, plugin-error>;

    /// The last `tail` captured output lines of one of the plugin's own processes.
    logs: func(id: string, tail: u32) -> result<list<string>, plugin-error>;

    /// The ids of the plugin's own running processes.
    %list: func() -> result<list<string>, plugin-error>;
}
