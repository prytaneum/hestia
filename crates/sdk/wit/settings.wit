package hestia:plugin@1.0.0;

interface settings {
    use types.{json, plugin-error};

    /// The calling plugin's own setting as JSON: what the user set, else the
    /// manifest's default. A secret arrives in clear. `none` when the key is
    /// unset without a default, or the plugin declares no such key.
    get: func(key: string) -> option<json>;

    /// Stores `value` as the plugin's own setting `key`, checked against the
    /// manifest's declaration exactly as the user's write is: `not-found` for a
    /// key the manifest does not declare, `invalid` for a value of the wrong
    /// kind or outside its constraints. `null` clears the key back to its
    /// default. A secret is stored like any other and never logged.
    ///
    /// The user's clients are told the settings changed; the plugin's own
    /// `on-settings-changed` is not run for its own write, so setting a key from
    /// there cannot loop.
    set: func(key: string, value: json) -> result<_, plugin-error>;
}

interface settings-changed {
    /// Runs after the user changed `key` in the plugin's settings (or cleared
    /// it); read the new value with `settings.get`.
    on-settings-changed: func(key: string);
}
