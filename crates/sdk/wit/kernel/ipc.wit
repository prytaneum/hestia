package hestia:kernel@0.1.0;

/// Permission `ipc:connect`, unrestricted. A unix socket or Windows named pipe
/// the manifest lists by its exact path; a path or pipe name of the other
/// platform is ignored. A plugin that imports `ipc` cannot have the permission
/// withheld at load: the interface holds a resource, which nothing can stub.
interface ipc {
    use types.{plugin-error};

    /// An open connection. It closes when dropped and, at the latest, when the
    /// call ends. At most 8 are open in one call.
    resource connection {
        /// Sends `bytes`, at most 1 MiB at a time.
        write: func(bytes: list<u8>) -> result<_, plugin-error>;

        /// Waits for up to `max` bytes (1 to 65536) and returns what arrived. An
        /// empty list means the peer closed its end.
        read: func(max: u32) -> result<list<u8>, plugin-error>;
    }

    /// Opens the endpoint, which must be one the manifest lists.
    connect: func(endpoint: string) -> result<connection, plugin-error>;
}
