package hestia:kernel@0.1.0;

/// What every plugin can import, whatever it exports.
world base {
    import types;
    import log;
    import app;
    import data;
    import settings;
    import secrets;
    import messages;
    import progress;
    import notify;
    import jobs;
}

/// What a plugin imports to reach outside itself, each asking for a permission
/// with a scope. Apart from `base` so that a plugin built from a world that
/// keeps every import (`jco`) is not asked to be granted these.
world reach {
    import download;
    import programs;
    import ipc;
}

/// Every import there is; the SDK and the host generate their bindings from it.
world everything {
    include base;
    include reach;
}

/// One world per export; the SDK's feature of the same name enables it.
world lifecycle-plugin {
    include base;
    export lifecycle;
}

world settings-changed-plugin {
    include base;
    export settings-changed;
}

world commands-plugin {
    include base;
    export commands;
}

world on-schedule-plugin {
    include base;
    export on-schedule;
}

world on-job-done-plugin {
    include base;
    export on-job-done;
}

/// The host's view: every import and every export, each export found on its own.
world host {
    include everything;
    export lifecycle;
    export settings-changed;
    export commands;
    export on-schedule;
    export on-job-done;
}
