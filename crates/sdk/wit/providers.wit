package hestia:plugin@1.0.0;

/// Every operation of every provider kind, through one call. The kinds, their
/// operations and each operation's arguments and reply are `proto::provider`:
/// a kind is data, so adding one never changes this interface.
interface provider {
    use types.{json, plugin-error};

    /// Answers the operation `op` of the provider `id` of kind `kind`, which the
    /// manifest contributes under `contributes.providers`. `args` is the
    /// operation's `Args` as JSON; answer its `Reply` as JSON, or `unsupported`
    /// for an operation the plugin does not implement.
    invoke: func(kind: string, id: string, op: string, args: json) -> result<json, plugin-error>;
}
