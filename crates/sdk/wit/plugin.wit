package hestia:plugin@1.0.0;

interface types {
    /// A JSON document in the shape of the matching `proto` type.
    type json = string;

    /// Why an upstream service answered a failure.
    record upstream-failure {
        /// The HTTP status, when the failure had one.
        status: option<u16>,
        /// Seconds the service asked to wait before trying again.
        retry-after: option<u32>,
        message: string,
    }

    /// A program or tool the operation needs and this computer lacks.
    record requirement {
        name: string,
        /// Where to get it, when known.
        url: option<string>,
    }

    /// Why a call failed, in either direction: the host answers a plugin's call
    /// with one, and a plugin answers the host's call with one. The host keeps
    /// the case, so a plugin can branch on it and the user is told what to do.
    variant plugin-error {
        /// Nothing matches what was asked for.
        not-found(string),
        /// The request is malformed or not valid right now.
        invalid(string),
        /// The plugin lacks the permission or grant the call needs.
        denied(string),
        /// The plugin does not implement the operation it was asked.
        unsupported(string),
        /// The request never reached its host, or the daemon is offline. The
        /// detail names what could not be reached.
        offline(option<string>),
        /// An upstream service answered with a failure.
        upstream(upstream-failure),
        /// An upstream service asked to slow down; seconds to wait, when known.
        rate-limited(option<u32>),
        /// An account has to be signed in before the call can succeed.
        sign-in-required,
        /// A setting the call needs has no value; the string is its key.
        not-configured(string),
        /// Something the call needs is not installed on this computer.
        missing-requirement(requirement),
        /// Another operation holds what the call needs; try again later.
        busy(string),
        failed(string),
    }
}

interface log {
    trace: func(message: string);
    debug: func(message: string);
    info: func(message: string);
    warn: func(message: string);
    error: func(message: string);
}

interface host {
    use types.{json, plugin-error};

    /// Calls a daemon channel with the `proto` params as JSON; returns the `proto` result as JSON.
    call: func(channel: string, payload: json) -> result<json, plugin-error>;

    /// Starts a `Job` channel and returns its `Done` payload as JSON once it settles.
    run-job: func(channel: string, payload: json) -> result<json, plugin-error>;
}

interface lifecycle {
    use types.{plugin-error};

    /// Runs once when the plugin is enabled, on a store dropped afterwards: nothing
    /// kept in memory survives it. Use it for one-time setup in `data/` and for
    /// validating the plugin's environment.
    init: func() -> result<_, plugin-error>;
}

world plugin {
    import log;
    import host;
    import process;
    import progress;
    import settings;
    import ipc;
    import data;
    import download;
    import messages;
    export lifecycle;
    export commands;
    export events;
    export settings-changed;
    export ui;
    export hooks;
    export provider;
}
